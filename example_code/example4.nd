typedef chris;

fun increment (john : (chris*)$) : none
{
        john->andy += 1;
        john->elwin += 1;
}

typedef chris = {
        andy : int$ = 67;
        elwin : int$ = 41;
        rohit : chris*->none = increment;
}

typedef david = chris*;

fun main () : int
[
        x : david$ = new;
] 
{
        x->rohit (x);
        return 0;
}
